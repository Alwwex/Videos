  "scenes": [
    {
      "narration": {
        "cs": "Mezi Sluncem a Zemí je *prázdný vesmír*. Jak k nám teplo doletí?",
        "en": "Between the Sun and Earth is *empty space*. How does heat get here?",
        "ro": "Între Soare și Pământ e *spațiu gol*. Cum ajunge căldura?"
      },
      "headline": {
        "cs": "TEPLO|VAKUEM?",
        "en": "HEAT|THROUGH VACUUM?",
        "ro": "CĂLDURĂ|PRIN VID?"
      },
      "tag": "150 000 000 km",
      "accent": "yellow",
      "visual": {
        "type": "icon",
        "icon": "sun",
        "icon2": "earth",
        "relation": "arrow",
        "effect": "pulse",
        "caption": null
      }
    },
    {
      "narration": {
        "cs": "Teplo se přenáší *třemi způsoby*.",
        "en": "Heat travels in *three ways*.",
        "ro": "Căldura se transmite în *trei moduri*."
      },
      "headline": {
        "cs": "TŘI|CESTY",
        "en": "THREE|WAYS",
        "ro": "TREI|CĂI"
      },
      "tag": "HEAT TRANSFER",
      "accent": "teal",
      "visual": {
        "type": "steps",
        "items": [
          {
            "cs": "vedení",
            "en": "conduction",
            "ro": "conducție"
          },
          {
            "cs": "proudění",
            "en": "convection",
            "ro": "convecție"
          },
          {
            "cs": "záření",
            "en": "radiation",
            "ro": "radiație"
          }
        ],
        "active": 0
      }
    },
    {
      "narration": {
        "cs": "Vedení a proudění potřebují *hmotu*, třeba vzduch.",
        "en": "Conduction and convection need *matter*, like air.",
        "ro": "Conducția și convecția au nevoie de *materie*, ca aerul."
      },
      "headline": {
        "cs": "POTŘEBUJÍ|HMOTU",
        "en": "THEY NEED|MATTER",
        "ro": "AU NEVOIE|DE MATERIE"
      },
      "tag": "PARTICLES",
      "accent": "red",
      "visual": {
        "type": "particles",
        "mode": "hotcold",
        "label": null
      }
    },
    {
      "narration": {
        "cs": "Ve vesmíru ale žádná hmota skoro *není*.",
        "en": "But space has almost *no matter* at all.",
        "ro": "Dar în spațiu aproape *nu există* materie."
      },
      "headline": {
        "cs": "VAKUUM",
        "en": "VACUUM",
        "ro": "VID"
      },
      "tag": "≈ 0 Pa",
      "accent": "blue",
      "visual": {
        "type": "icon",
        "icon": "star",
        "icon2": "satellite",
        "relation": "none",
        "effect": "float",
        "caption": null
      }
    },
    {
      "narration": {
        "cs": "Zbývá *záření*, elektromagnetické vlny jako světlo.",
        "en": "That leaves *radiation*, electromagnetic waves like light.",
        "ro": "Rămâne *radiația*, unde electromagnetice ca lumina."
      },
      "headline": {
        "cs": "ZÁŘENÍ|VYHRÁVÁ",
