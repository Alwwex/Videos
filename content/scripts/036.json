    {
      "narration": {
        "cs": "Voda se tím natáhne do dvou *boulí*, k Měsíci i od něj.",
        "en": "This stretches the water into two *bulges*, toward and away.",
        "ro": "Apa se întinde în două *umflături*, spre Lună și opus."
      },
      "headline": {
        "cs": "DVĚ|BOULE",
        "en": "TWO|BULGES",
        "ro": "DOUĂ|UMFLĂTURI"
