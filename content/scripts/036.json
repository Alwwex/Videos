    "tides"
  ],
  "scenes": [
    {
      "narration": {
        "cs": "Dvakrát denně moře *stoupne* a zase ustoupí.",
        "en": "Twice a day the sea *rises* and falls back again.",
        "ro": "De două ori pe zi marea *crește* și scade din nou."
      },
      "headline": {
        "cs": "PŘÍLIV|A ODLIV",
        "en": "HIGH|AND LOW TIDE",
        "ro": "FLUX|ȘI REFLUX"
      },
      "tag": "TIDES",
