    {
      "narration": {
        "cs": "Na bližší stranu Země táhne *silněji* než na vzdálenější.",
        "en": "It pulls *harder* on Earth's near side than on the far side.",
        "ro": "Trage *mai tare* de partea apropiată decât de cea îndepărtată."
      },
      "headline": {
        "cs": "BLÍŽ =|SILNĚJI",
        "en": "CLOSER =|STRONGER",
