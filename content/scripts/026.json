    "heat"
  ],
  "scenes": [
    {
      "narration": {
        "cs": "Horký vzduch stoupá. Ale *nic ho netáhne* nahoru.",
        "en": "Hot air rises. But *nothing pulls it* upward.",
        "ro": "Aerul cald urcă. Dar *nimic nu-l trage* în sus."
      },
      "headline": {
        "cs": "CO HO|TÁHNE?",
        "en": "WHAT PULLS|IT UP?",
        "ro": "CE ÎL|TRAGE?"
