  "scenes": [
    {
      "narration": {
        "cs": "Pustíš kladivo a pírko. Co dopadne *první*?",
        "en": "Drop a hammer and a feather. Which lands *first*?",
        "ro": "Scapi un ciocan și o pană. Care cade *primul*?"
      },
      "headline": {
        "cs": "CO DOPADNE|PRVNÍ?",
        "en": "WHICH LANDS|FIRST?",
        "ro": "CARE CADE|PRIMUL?"
      },
      "tag": "THOUGHT EXPERIMENT",
      "accent": "yellow",
      "visual": {
        "type": "quiz",
        "question": {
          "cs": "Ve vzduchoprázdnu dopadne dřív…",
          "en": "In a vacuum, the first to land is…",
          "ro": "În vid, primul care cade e…"
        },
        "options": [
          {
            "cs": "kladivo",
            "en": "the hammer",
            "ro": "ciocanul"
          },
          {
            "cs": "pírko",
            "en": "the feather",
            "ro": "pana"
          },
          {
            "cs": "dopadnou spolu",
            "en": "they land together",
            "ro": "cad împreună"
          }
        ],
        "answer": 2
      }
    },
    {
      "narration": {
        "cs": "Ve vzduchoprázdnu dopadnou *úplně současně*.",
        "en": "In a vacuum they land at *exactly the same time*.",
        "ro": "În vid cad *exact în același timp*."
      },
      "headline": {
        "cs": "DOPADNOU|SPOLU",
        "en": "THEY LAND|TOGETHER",
