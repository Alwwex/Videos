    {
      "narration": {
        "cs": "Zvuk je *vlna*, tlak vzduchu kmitá nahoru a dolů.",
        "en": "Sound is a *wave*, air pressure going up and down.",
        "ro": "Sunetul e o *undă*, presiunea aerului urcă și coboară."
      },
      "headline": {
        "cs": "ZVUK|JE VLNA",
        "en": "SOUND|IS A WAVE",
        "ro": "SUNETUL|E O UNDĂ"
