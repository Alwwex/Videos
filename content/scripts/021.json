        "ro": "Un microfon pe căști *ascultă continuu* zgomotul."
      },
      "headline": {
        "cs": "MIKROFON|POSLOUCHÁ",
        "en": "THE MIC|LISTENS",
        "ro": "MICROFONUL|ASCULTĂ"
