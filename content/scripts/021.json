  "description": {
    "cs": "Sluchátka s ANC přidají zvuk, aby bylo ticho. Zní to šíleně, ale funguje to. 🎧",
    "en": "ANC headphones add sound to make silence. Sounds crazy, but it works. 🎧",
    "ro": "Căștile ANC adaugă sunet ca să facă liniște. Pare nebunesc, dar merge. 🎧"
  },
  "hashtags": [
    "fyzika",
    "physics",
    "science",
    "sluchatka",
    "zvuk",
    "headphones"
  ],
  "scenes": [
    {
      "narration": {
        "cs": "Tyhle sluchátka *přidají zvuk*, aby bylo ticho.",
        "en": "These headphones *add sound* to create silence.",
        "ro": "Căștile astea *adaugă sunet* ca să fie liniște."
      },
      "headline": {
        "cs": "ZVUK, KTERÝ|MAŽE ZVUK",
        "en": "SOUND THAT|ERASES SOUND",
        "ro": "SUNET CARE|ȘTERGE SUNET"
