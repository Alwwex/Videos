        "ro": "Un cip creează o *undă oglindă*, perfect inversată."
      },
      "headline": {
        "cs": "OBRÁCENÁ|VLNA",
        "en": "FLIPPED|WAVE",
        "ro": "UNDĂ|INVERSATĂ"
