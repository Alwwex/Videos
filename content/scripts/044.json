      "tag": "PUZZLE",
      "accent": "yellow",
      "visual": {
        "type": "icon",
        "icon": "mirror",
        "icon2": "person",
        "relation": "none",
        "effect": "pulse",
        "caption": null
      }
    },
    {
      "narration": {
        "cs": "Odpověď: neprohazuje *ani jedno*.",
        "en": "The answer: it swaps *neither*.",
        "ro": "Răspunsul: nu inversează *niciuna*."
      },
      "headline": {
        "cs": "NEPROHAZUJE|NIC",
        "en": "IT SWAPS|NEITHER",
