  "title": {
    "cs": "Proč zrcadlo prohazuje levou a pravou",
    "en": "Does a mirror flip left and right?",
    "ro": "Oglinda inversează stânga cu dreapta?"
  },
  "description": {
    "cs": "Zrcadlo ve skutečnosti levou a pravou neprohazuje. Prohazuje něco jiného. 🪞",
    "en": "A mirror doesn't actually swap left and right. It swaps something else. 🪞",
    "ro": "Oglinda nu inversează de fapt stânga cu dreapta. Inversează altceva. 🪞"
  },
  "hashtags": [
    "fyzika",
    "physics",
    "science",
    "zrcadlo",
    "optika",
    "mirror"
  ],
  "scenes": [
    {
      "narration": {
        "cs": "Proč zrcadlo prohodí levou a pravou, ale *ne nahoru a dolů*?",
        "en": "Why does a mirror swap left and right, but *not up and down*?",
        "ro": "De ce oglinda inversează stânga cu dreapta, dar *nu sus cu jos*?"
      },
      "headline": {
        "cs": "PROČ NE|NAHORU-DOLŮ?",
        "en": "WHY NOT|UP AND DOWN?",
        "ro": "DE CE NU|SUS-JOS?"
