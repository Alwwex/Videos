    {
      "narration": {
        "cs": "Zrcadlo převrací jen směr *k němu a od něj*.",
        "en": "A mirror only flips the direction *toward and away* from it.",
        "ro": "Oglinda inversează doar direcția *spre ea și dinspre ea*."
      },
      "headline": {
        "cs": "PŘEDEK ↔|ZADEK",
        "en": "FRONT ↔|BACK",
        "ro": "FAȚĂ ↔|SPATE"
