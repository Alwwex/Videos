    },
    {
      "narration": {
        "cs": "Vědci se o detailech *přou dodnes*.",
        "en": "Scientists are *still arguing* about the details today.",
        "ro": "Oamenii de știință *încă se ceartă* pe detalii."
      },
      "headline": {
        "cs": "STÁLE|ZÁHADA",
        "en": "STILL A|MYSTERY",
        "ro": "ÎNCĂ UN|MISTER"
      },
