    "@remotion/three": "^4.0.540",
    "react": "^19.3.1",
    "react-dom": "^19.3.1",
    "remotion": "^4.0.540",
    "three": "0.186.1",
    "zod": "^4.6.7"
  },
  "devDependencies": {
    "@types/node": "^26.6.6",
    "@types/react": "^19.3.0",
